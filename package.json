{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agentflow": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check src/server.js && node --check public/app.js",
    "test:live": "node scripts/live-speech.js && node scripts/live-terminal.js",
    "postinstall": "node scripts/prepare-pty.js",
    "test:live:claude": "node scripts/live-claude-inbox.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
