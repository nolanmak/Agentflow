{
  "name": "agentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "agentflow": "./dist/src/cli.js"
  },
  "scripts": {
    "start": "node dist/src/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run typecheck",
    "test:live": "node dist/scripts/live-speech.js && node dist/scripts/live-terminal.js",
    "postinstall": "node scripts/prepare-pty.ts",
    "test:live:claude": "node dist/scripts/live-claude-inbox.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node dist/scripts/build-assets.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/ws": "8.18.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
